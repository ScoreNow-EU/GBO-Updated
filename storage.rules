rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /documents/{allPaths=**} {
      // Allow read for all authenticated users
      allow read: if request.auth != null;
      // Allow write for authenticated users
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024  // 10MB max
                   && request.resource.contentType.matches('application/pdf|image/.*');
    }
    match /sponsors/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024  // 5MB max
                   && request.resource.contentType.matches('image/.*');
    }
    match /playerImages/{playerId}/{allPaths=**} {
      // Profile photos are public-readable for authenticated users.
      allow read: if request.auth != null;
      // Authenticated users may upload (write rules at app layer restrict
      // edit affordance to admin / team manager); 5 MB image cap.
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    match /teamLogos/{teamId}/{allPaths=**} {
      // Team logos readable by all authenticated users.
      allow read: if request.auth != null;
      // Write restricted to authenticated users (admin / team manager
      // enforced at app layer); 5 MB image cap.
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
