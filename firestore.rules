rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && role in getUserData().roles;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isAdminOrSeriesOrganizer() {
      return isAdmin() || hasRole('seriesOrganizer');
    }

    function isTeamRHD() {
      return hasRole('teamRHD');
    }

    function isAdminOrTeamRHD() {
      return isAdmin() || isTeamRHD();
    }

    // ── Users ─────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // ── Configuration documents (admin only) ────────────────────────
    // youtube_oauth contains the league-wide YouTube refresh token.
    // Only admins can read/write; clients use a callable function to
    // create broadcasts and never need direct access.
    match /config/{configId} {
      allow read, write: if isAdmin();
    }

    // ── Tournaments (public read for scoreboard) ────────────────────
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create: if isAuthenticated() && isAdminOrSeriesOrganizer();
      allow update: if isAuthenticated() && isAdminOrSeriesOrganizer();
      allow delete: if isAdmin();

      // Games subcollection under tournaments — public read
      match /games/{gameId} {
        allow read: if true;
        allow create: if isAuthenticated() && isAdminOrSeriesOrganizer();
        allow update: if isAuthenticated();
        allow delete: if isAdmin();
      }
    }

    // ── Teams (public read for scoreboard) ────────────────────────
    match /teams/{teamId} {
      allow read: if true;
      allow create: if isAuthenticated() && (isAdminOrSeriesOrganizer() || hasRole('teamManager'));
      allow update: if isAuthenticated() && (isAdminOrSeriesOrganizer() || hasRole('teamManager'));
      allow delete: if isAdmin();
    }

    // ── Games (top-level, public read) ────────────────────────────
    match /games/{gameId} {
      allow read: if true;
      allow create: if isAuthenticated() && isAdminOrSeriesOrganizer();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // ── Referees ──────────────────────────────────────────────────────
    match /referees/{refereeId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }

    // ── Kampfgericht Members ──────────────────────────────────────────
    match /kampfgericht_members/{memberId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }

    // ── Delegates ─────────────────────────────────────────────────────
    match /delegates/{delegateId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }

    // ── Donations ─────────────────────────────────────────────────────
    match /donations/{donationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && isAdmin();
    }

    // ── Notifications ─────────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isAdminOrSeriesOrganizer();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && isAdmin();
    }

    // ── Coach Auth Requests ───────────────────────────────────────────
    match /coach_auth_requests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // ── Ligapunkte (League Points) ────────────────────────────────────
    match /ligapunkte/{entryId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdminOrSeriesOrganizer();
    }

    // ── App Settings / Config ─────────────────────────────────────────
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }

    // ── Protests ──────────────────────────────────────────────────────
    match /protests/{protestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (isAdminOrTeamRHD() || hasRole('delegate'));
      allow delete: if isAdmin();
    }

    // ── Suspensions ───────────────────────────────────────────────────
    match /suspensions/{suspensionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isAdminOrTeamRHD();
      allow update: if isAuthenticated() && isAdminOrTeamRHD();
      allow delete: if isAdmin();
    }

    // ── Stories (public read, admin/teamRHD write) ────────────────────
    match /stories/{storyId} {
      allow read: if true;
      allow create: if isAuthenticated() && isAdminOrTeamRHD();
      allow update: if isAuthenticated() && isAdminOrTeamRHD();
      allow delete: if isAuthenticated() && isAdminOrTeamRHD();
    }

    // ── Seasons ───────────────────────────────────────────────────────
    match /seasons/{seasonId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isAdminOrTeamRHD() || hasRole('seriesOrganizer'));
      allow update: if isAuthenticated() && (isAdminOrTeamRHD() || hasRole('seriesOrganizer'));
      allow delete: if isAdmin();
    }

    // ── Venues ────────────────────────────────────────────────────────
    match /venues/{venueId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isAdminOrSeriesOrganizer();
      allow update: if isAuthenticated() && isAdminOrSeriesOrganizer();
      allow delete: if isAdmin();
    }

    // ── Fines ─────────────────────────────────────────────────────────
    match /fines/{fineId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isAdminOrTeamRHD();
      allow update: if isAuthenticated() && isAdminOrTeamRHD();
      allow delete: if isAdmin();
    }

    // ── Game Events (public read for scoreboard) ──────────────────────
    match /gameEvents/{eventId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // ── Game Reports ──────────────────────────────────────────────────
    match /gameReports/{reportId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // ── Game Squads ───────────────────────────────────────────────────
    match /gameSquads/{squadId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // ── Custom Notifications ──────────────────────────────────────────
    match /custom_notifications/{notifId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // ── Transfers ─────────────────────────────────────────────────────
    match /transfers/{transferId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && isAdminOrTeamRHD();
      allow delete: if isAdmin();
    }

    // ── Documents ─────────────────────────────────────────────────────
    match /documents/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isAdminOrTeamRHD();
      allow update: if isAuthenticated() && isAdminOrTeamRHD();
      allow delete: if isAdmin();
    }

    // ── Error Reports (write-only sink for global error boundary) ─────
    // Anyone (auth or unauth) may create a single error doc; size capped
    // via field length checks. Only admins may read/delete via console.
    match /errorReports/{reportId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.error is string
                    && request.resource.data.error.size() <= 4100
                    && (!('stack' in request.resource.data)
                        || request.resource.data.stack.size() <= 4100);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ── Team Managers ─────────────────────────────────────────────────
    match /team_managers/{managerId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isAdminOrTeamRHD();
      allow update: if isAuthenticated() && isAdminOrTeamRHD();
      allow delete: if isAdmin();
    }

    // ── Players ───────────────────────────────────────────────────────
    match /players/{playerId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isAdminOrTeamRHD();
      allow update: if isAuthenticated() && isAdminOrTeamRHD();
      allow delete: if isAdmin();
    }

    // ── Managed Accounts ──────────────────────────────────────────────
    match /managed_accounts/{accountId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isAdmin();
      allow update: if isAuthenticated() && isAdmin();
      allow delete: if isAdmin();
    }

    // ── Observation Templates (admin write, any auth read) ────────────
    match /observation_templates/{templateId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Referee Observations ──────────────────────────────────────────
    match /referee_observations/{observationId} {
      allow read: if isAdmin()
                  || hasRole('delegate')
                  || (hasRole('teamManager') && resource.data.submitterId == request.auth.uid)
                  || (hasRole('referee') && request.auth.uid in resource.data.refereeIds);
      allow create: if isAuthenticated()
                    && (hasRole('delegate') || hasRole('teamManager'));
      allow update: if isAdmin()
                    || (resource.data.submitterId == request.auth.uid
                        && resource.data.status == 'draft');
      allow delete: if isAdmin()
                    || (resource.data.submitterId == request.auth.uid
                        && resource.data.status == 'draft');
    }

    // ── Deny all other collections by default ─────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
